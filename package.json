{
  "name": "solana-onchain-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Solana On-chain Intelligence Assistant — Milestone 1: fetch a transaction from RPC, normalize it into our own model, print a readable CLI summary.",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "inspect": "tsx src/cli/inspect.ts",
